# Required runtime selection
APP_TARGET=resident
APP_ENV=test
DEVICE_TARGET=emulator
ANDROID_UDID=emulator-5554
IOS_UDID=
IOS_PHYSICAL_UDID=
IOS_DEVICE_NAME=
IOS_PLATFORM_VERSION=
IOS_BUNDLE_ID=
IOS_XCODE_ORG_ID=
IOS_XCODE_SIGNING_ID=
IOS_WDA_BUNDLE_ID=
# Default: use the selected app installed from Google Play.
# Optional approved test APK override: APP_SOURCE=apk and set APP_PATH below.
APP_SOURCE=installed
PLAYSTORE_BETA_CONFIRMED=true
# Required by Resident Play Store live validation; set from the approved release.
APP_EXPECTED_PLAYSTORE_VERSION_CODE=
PRODUCTION_SMOKE_CONFIRMED=false
PRODUCTION_CREDENTIAL_LOGIN_CONFIRMED=false
PRODUCTION_TEST_ACCOUNT_CONFIRMED=false
# Optional; required only when APP_SOURCE=apk. APKs must use the isolated .e2e package.
APP_PATH=

# Safety and execution
TEST_API_BASE_URL=https://test.isocietymanager.com
RESET_MODE=clean
TEST_LANE=smoke
RUN_HARDWARE_TESTS=false
ALLOW_MUTATIONS=false
AVD_NAME=Pixel_9_Pro

# Resident default account (new user/unit model)
RESIDENT_USERNAME=
RESIDENT_PASSWORD=
RESIDENT_ACCOUNT_UNIT=

# Resident legacy account used only for production-regression A/B coverage
RESIDENT_LEGACY_USERNAME=
RESIDENT_LEGACY_PASSWORD=
RESIDENT_LEGACY_ACCOUNT_UNIT=
# JSON array of verified legacy family accounts; keep credentials only in ignored .env
RESIDENT_LEGACY_FAMILY_ACCOUNTS_JSON=

# Approved Resident production-regression fixture data (leave blank by default)
RESIDENT_SOURCE_CASE=
RESIDENT_ACCOUNT_COHORT=
RESIDENT_TEST_CONTACT_MOBILE=
RESIDENT_TEST_CONTACT_EMAIL=
RESIDENT_TEST_COMPLAINT_CATEGORY=
RESIDENT_TEST_COMPLAINT_SUBCATEGORY=
RESIDENT_TEST_SITE_ID=
RESIDENT_TEST_COMPLAINT_AREA_TYPE=
RESIDENT_TEST_COMPLAINT_LOCATION=

# Technician test-tenant account
TECHNICIAN_USERNAME=
TECHNICIAN_PASSWORD=
TECHNICIAN_QR_PAYLOAD=
TECHNICIAN_QR_EXPECTED_SEQUENCE=

# Safe negative-auth input; must not identify a real account
INVALID_LOGIN_IDENTITY=appium.invalid@example.invalid

# Physical QR lane values must identify a controlled asset and one associated work order.

# Attendance Geofence Location (defaults to Etawah Junction coordinates if blank)
TECHNICIAN_GEOFENCE_LAT=
TECHNICIAN_GEOFENCE_LON=

# Upcoming Work Order Search Test Fixtures
TECHNICIAN_TEST_WO_TITLE=
TECHNICIAN_TEST_ASSET=
TECHNICIAN_TEST_LOCATION=
